# ============================================================
# MedDraft_AI — Environment Configuration
# ============================================================
# Choose your LLM provider path: "dual" or "simple"
LLM_PROVIDER=simple

# --- Path A: Simplified Single Provider ---
# Works with Claude, OpenAI, Gemini, DeepSeek, or any OpenAI-compatible API
SIMPLE_API_KEY=sk-your-api-key-here
SIMPLE_BASE_URL=https://api.openai.com/v1
SIMPLE_MODEL=gpt-4o

# --- Path B: Dual Provider (DeepSeek + Qwen VL) ---
MAIN_BASE_URL=http://localhost:3284/v1
MAIN_MODEL=deepseek-v4-flash-free
VISION_BASE_URL=http://localhost:11434
VISION_MODEL=qwen2.5vl:3b
VISION_ROUTING_ENABLED=true

# --- Academic Database API Keys ---
NCBI_API_KEY=
OPENALEX_API_KEY=
SCIENCEDIRECT_API_KEY=
APIFY_TOKEN=
FINDPAPERS_EMAIL=

# --- Browser Engine Automation ---
# Headful by default (stealth checks, extensions, manual CAPTCHA solving).
# Set BROWSER_HEADLESS=true to force headless (extensions disabled, CAPTCHAs unsolvable).
BROWSER_HEADLESS=false
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
