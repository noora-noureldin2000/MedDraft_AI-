# ============================================================
# MedDraft_AI — Environment Configuration
# ============================================================
# Choose your LLM provider path: "dual" or "simple"
LLM_PROVIDER=simple

# --- Path A: Simplified Single Provider ---
# Works with Claude, OpenAI, Gemini, DeepSeek, or any OpenAI-compatible API
SIMPLE_API_KEY=sk-your-api-key-here
SIMPLE_BASE_URL=https://api.openai.com/v1
SIMPLE_MODEL=gpt-4o

# --- Path B: Dual Provider (DeepSeek + Qwen VL) ---
MAIN_BASE_URL=http://localhost:3284/v1
MAIN_MODEL=deepseek-v4-flash-free
VISION_BASE_URL=http://localhost:11434
VISION_MODEL=qwen2.5vl:3b
VISION_ROUTING_ENABLED=true

# --- Academic Database API Keys ---
NCBI_API_KEY=
OPENALEX_API_KEY=
SCIENCEDIRECT_API_KEY=
APIFY_TOKEN=
FINDPAPERS_EMAIL=

# --- Google Images Search (provider-chained fallback) ---
# Order: SerpApi -> Brave -> Playwright.
# Google Custom Search JSON API is legacy: closed to new customers, and
# existing access ends 2027-01-01. Add "google_cse" to the order only if your
# project already had access before the closure.
# Free tiers: SerpApi 100/month, Brave 2,000/month.
SERP_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
BRAVE_API_KEY=
# Optional overrides
IMAGE_SEARCH_PROVIDER_ORDER=serpapi,brave,browser
IMAGE_SEARCH_TIMEOUT=20
IMAGE_SEARCH_BROWSER_TIMEOUT=150
IMAGE_SEARCH_QUOTA_ENABLED=true
# IMAGE_SEARCH_QUOTA_FILE=.cache/image_search_quota.json

# --- Browser Engine Automation ---
# Headful by default (stealth checks, extensions, manual CAPTCHA solving).
# Set BROWSER_HEADLESS=true to force headless (extensions disabled, CAPTCHAs unsolvable).
BROWSER_HEADLESS=false
# Optional fingerprint alignment for proxy users — leave empty to inherit host settings.
# Example: BROWSER_LOCALE=en-US, BROWSER_TIMEZONE_ID=America/New_York
BROWSER_LOCALE=
BROWSER_TIMEZONE_ID=
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
